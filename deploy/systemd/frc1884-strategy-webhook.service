[Unit]
Description=FRC 1884 Strategy GitHub Webhook
After=network.target

[Service]
Type=simple
User=frc1884-strategy-webhook
Group=frc1884-strategy-webhook
SupplementaryGroups=frc1884-strategy-trigger
WorkingDirectory=/
Environment=NODE_ENV=production
Environment=PORT=3013
EnvironmentFile=/etc/frc1884-strategy/webhook.env
ExecStart=/usr/bin/node /usr/local/libexec/frc1884-strategy/github-webhook-server.mjs
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectProc=invisible
ProcSubset=pid
UMask=0027
TemporaryFileSystem=/srv:ro /opt:ro /var/lib:ro /var/cache:ro
InaccessiblePaths=-/run/agent-app-secrets -/run/openclaw -/run/openclaw-prod -/run/agent-ssh-995 -/run/agent-ssh-1000 -/run/agent-1password
UMask=0007
BindPaths=/var/lib/frc1884-strategy-request
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
